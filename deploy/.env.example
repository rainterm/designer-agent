# =====================================================================
# Designer Admin 生产环境变量模板
# 使用：cp .env.example .env 后按需修改
#   ./deploy-db.sh   # 仅 MySQL + Redis
#   ./deploy-app.sh  # 构建部署 Server + 管理后台
# =====================================================================

# ---- 对外访问（应用）----
# 管理后台 Nginx 宿主机端口（浏览器访问 http://服务器IP:APP_PORT）
APP_PORT=80
# 后端 API 宿主机端口（直连 http://服务器IP:SERVER_PORT ，容器内仍为 8080）
SERVER_PORT=8080

# ---- 数据库基础设施（./deploy-db.sh）----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=designer_agent
MYSQL_USER=root
MYSQL_PASSWORD=root
# 宿主机映射端口
MYSQL_PORT=3306

REDIS_PASSWORD=123456
REDIS_PORT=6379

# ---- MinIO（docker-compose.minio.yml）----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Milvus（./deploy-milvus.sh）----
# 应用默认 designer.agent.milvus.uri=http://localhost:19530
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
# 应用容器连本机 Milvus 时用 host.docker.internal
MILVUS_URI=http://host.docker.internal:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
AGENT_WORKSPACE=./data/agent-harness
# 智能体异步任务并发上限（SSE 对话 / 工作流 / 索引进度）
AGENT_ASYNC_MAX_CONCURRENT=64

# ---- 应用连接库（./deploy-app.sh）----
# 本机 Docker 部署的库：用 host.docker.internal 访问宿主机已映射端口
# 外部云数据库：改为真实地址，如 10.0.0.12 或 rm-xxx.mysql.rds.aliyuncs.com
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=designer_agent
DB_USER=root
# 与 MYSQL_ROOT_PASSWORD 保持一致（使用本机 deploy-db 时）
DB_PASSWORD=root

REDIS_HOST=host.docker.internal
# 与上方 REDIS_PORT / REDIS_PASSWORD 一致（使用本机 deploy-db 时）
REDIS_DB=5

# ---- 后端 JVM（可选）----
JAVA_OPTS="-Xms512m -Xmx1024m -Dfile.encoding=UTF-8"

# ---- 配置密钥加密（可选）----
# 存储配置的 accessKey / secretKey 与消息通道的 SMTP 密码，落库前用该主密钥加密成 ENC(...)。
# 留空则保持明文；AES 只接受 16 / 24 / 32 字节，请通过环境变量注入，不要提交到仓库。
VAULT_PASSWORD=

# ---- 接口文档（可选）----
# 访问 http://服务器IP:SERVER_PORT/doc.html；生产环境建议关闭
KNIFE4J_ENABLE=true
KNIFE4J_PRODUCTION=false

# ---- 镜像 / 项目名 ----
IMAGE_TAG=1.0.0
COMPOSE_PROJECT_NAME=designer-admin
